# Copy this file to .env and fill in real values before running
# `docker compose up -d`.

# The password you'll type into the Recipe Box login screen.
RECIPE_APP_PASSWORD=changeme

# A long random string used to sign login session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Host port to publish the app on (default 8090).
RECIPE_BOX_PORT=8090

# Optional: override the guessed grocery-store search URL pattern if the
# default 404s for you. {query} is replaced with the ingredient text.
# PRISMA_SEARCH_URL_TEMPLATE=https://www.s-kaupat.fi/haku?query={query}
# CITYMARKET_SEARCH_URL_TEMPLATE=https://www.k-ruoka.fi/kauppa/haku?query={query}
